    "dist:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "jsbarcode": "^3.7.1",
    "qrcode": "^1.5.4",
    "jspdf": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
